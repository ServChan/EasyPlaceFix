{
  "schemaVersion": 1,
  "id": "easyplacefix",
  "version": "${version}",
  "name": "EasyPlaceFix",
  "description": "A mod that fixes Litematica Easy Place behavior in multiplayer.",
  "authors": [
    "LTS_Server"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/easyplacefix-fork",
    "sources": "https://github.com/ServChan/EasyPlaceFix",
    "issues": "https://github.com/ServChan/EasyPlaceFix/issues"
  },
  "license": "MIT",
  "icon": "assets/easyplacefix/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.uiop.easyplacefix.EasyPlaceFix"
    ]
  },
  "mixins": [
    "easyplacefix.mixins.json"
  ],
  "depends": {
    "java": ">=25",
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "litematica": ">=0.27.10 <=0.28.4",
    "malilib": ">=0.28.9 <=0.29.3",
    "minecraft": ">=26.1.2 <=26.2"
  }
}
